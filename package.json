{
	"name": "@binyamin/njk",
	"version": "0.1.1",
	"description": "A small cli for nunjucks",
	"bin": {
		"njk": "index.cjs"
	},
	"type": "module",
	"main": "app.js",
	"types": "./app.d.ts",
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/binyamin/nunjucks-cli"
	},
	"keywords": [],
	"author": "Binyamin Aron Green (https://binyam.in/)",
	"license": "MIT",
	"scripts": {
		"prebuild": "esbuild index.cjs --bundle --minify --outdir=dist --tree-shaking --platform=node",
		"build": "pkg dist/index.js -o dist/njk -C brotli",
		"lint": "xo",
		"test": "ava"
	},
	"dependencies": {
		"camelcase": "^9.0.0",
		"commander": "^15.0.0",
		"dayjs": "^1.11.21",
		"js-yaml": "^5.2.1",
		"nunjucks": "^3.2.4"
	},
	"devDependencies": {
		"ava": "^8.0.1",
		"esbuild": "^0.28.1",
		"mock-fs": "^5.5.0",
		"pkg": "^5.8.1",
		"xo": "^4.0.0"
	}
}
